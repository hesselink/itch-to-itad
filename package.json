{
  "name": "itch-to-itad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "fetch-itch": "node --env-file-if-exists=.env src/cli/fetch-itch.ts",
    "itad-login": "node --env-file-if-exists=.env src/cli/itad-login.ts",
